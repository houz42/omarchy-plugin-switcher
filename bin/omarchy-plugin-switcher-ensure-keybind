#!/bin/bash
# Idempotently appends the default Plugin Switcher keybinding to
# ~/.config/hypr/bindings.lua on the plugin's first-ever load (see
# Panel.qml's PersistentProperties bootstrap -- this only runs once per
# install, not on every open). Safe to re-run: a no-op if the line is
# already there, e.g. after a user edited or removed it themselves.

set -euo pipefail

BINDINGS="$HOME/.config/hypr/bindings.lua"
MARKER="houz42.plugin-switcher"
LINE='o.bind("SUPER + ALT + P", "Plugin Switcher", "omarchy-shell shell toggle houz42.plugin-switcher")'

if [[ -f $BINDINGS ]] && grep -qF "$MARKER" "$BINDINGS"; then
  exit 0
fi

{
  echo ""
  echo "-- Added by omarchy-plugin-switcher on first load. Change the key or"
  echo "-- remove this block any time; it won't be re-added."
  echo "$LINE"
} >> "$BINDINGS"

hyprctl reload >/dev/null 2>&1 || true
