#!/bin/bash
# Manages the once-ever "add the default keybinding?" consent flow.
# State lives on disk under ~/.local/state/omarchy/<id>/, the same
# convention other Omarchy plugins use for persisted state -- QML's
# PersistentProperties only reliably survives hot-reloads within the same
# quickshell process, not a full `omarchy restart shell` (new process),
# so it can't be trusted for a once-per-install decision on its own.
#
# Usage: omarchy-plugin-switcher-keybind <status|accept|decline>
#   status   Prints one of:
#              present  -- a binding mentioning this plugin already exists
#                          (accepted before, or added manually)
#              declined -- already asked and said no
#              accepted -- accepted before, binding later removed by hand
#                          (deliberate; don't ask again)
#              ask      -- never decided
#            Panel.qml only shows the consent dialog on "ask".
#   accept   Adds the binding to bindings.lua and reloads Hyprland.
#            Idempotent: a second accept while the binding is present is a
#            no-op. The edit is made atomically (temp file + rename in the
#            same directory) with a timestamped backup at
#            bindings.lua.bak.<timestamp>, under a lock so two accepts
#            can't interleave, and only after rejecting symlinked or
#            non-regular config targets. The accepted decision itself is
#            recorded on disk, so removing the binding later does NOT
#            bring the prompt back.
#   decline  Records the decision so the dialog isn't shown again.

set -euo pipefail

BINDINGS_DIR="$HOME/.config/hypr"
BINDINGS="$BINDINGS_DIR/bindings.lua"
MARKER="houz42.plugin-switcher"
LINE='o.bind("SUPER + ALT + P", "Plugin Switcher", "omarchy-shell shell toggle houz42.plugin-switcher")'
STATE_DIR="$HOME/.local/state/omarchy/houz42.plugin-switcher"
DECLINED_FILE="$STATE_DIR/keybind-declined"
ACCEPTED_FILE="$STATE_DIR/keybind-accepted"
LOCK_FILE="$STATE_DIR/keybind.lock"

die() {
  echo "omarchy-plugin-switcher-keybind: $*" >&2
  exit 1
}

# Refuse to follow a symlink anywhere we write: a pre-existing symlink
# could redirect the edit to an unrelated file.
reject_symlink() {
  [[ -L $1 ]] && die "$1 is a symlink; refusing to touch it"
  return 0
}

ensure_state_dir() {
  reject_symlink "$(dirname "$STATE_DIR")"
  reject_symlink "$STATE_DIR"
  if ! install -d -m 700 "$STATE_DIR"; then
    die "cannot create state directory $STATE_DIR"
  fi
}

# Serialize accept/decline so two concurrent invocations can't duplicate
# or corrupt either bindings.lua or the decision markers.
take_lock() {
  exec 9>"$LOCK_FILE"
  flock 9
}

# Atomic, private-permission marker write (temp + rename, same directory).
write_marker() {
  reject_symlink "$1"
  local tmp
  tmp="$(mktemp "$STATE_DIR/.marker.XXXXXX")"
  printf 'decided %s\n' "$(date -Iseconds)" > "$tmp"
  chmod 600 "$tmp"
  mv -f -- "$tmp" "$1"
}

binding_present() {
  [[ -f $BINDINGS ]] && grep -qF "$MARKER" "$BINDINGS"
}

# Validate the edit target BEFORE writing: parent must be a real
# directory, target must be a regular file (or absent, in which case we
# create it) -- never a symlink or another file type.
validate_bindings_target() {
  reject_symlink "$BINDINGS_DIR"
  [[ -d $BINDINGS_DIR ]] || die "$BINDINGS_DIR does not exist; is Hyprland configured?"
  reject_symlink "$BINDINGS"
  if [[ -e $BINDINGS && ! -f $BINDINGS ]]; then
    die "$BINDINGS exists and is not a regular file"
  fi
}

TMP_FILE=""

cleanup_tmp() {
  [[ -n $TMP_FILE && -e $TMP_FILE ]] && rm -f -- "$TMP_FILE"
  return 0
}

case "${1:-}" in
  status)
    if binding_present; then
      echo "present"
    elif [[ -f $DECLINED_FILE ]]; then
      echo "declined"
    elif [[ -f $ACCEPTED_FILE ]]; then
      echo "accepted"
    else
      echo "ask"
    fi
    ;;
  accept)
    ensure_state_dir
    take_lock
    # Second accept while the binding is already there: nothing to do.
    binding_present && exit 0
    validate_bindings_target
    trap cleanup_tmp EXIT
    # Recoverable backup first, so a bad edit is never the only copy.
    if [[ -f $BINDINGS ]]; then
      cp -a -- "$BINDINGS" "$BINDINGS.bak.$(date +%Y%m%d%H%M%S)"
    fi
    # Same-directory temp + atomic rename, preserving the original
    # file's mode (same-UID owner is preserved by construction).
    TMP_FILE="$(mktemp "$BINDINGS_DIR/.bindings.lua.XXXXXX")"
    if [[ -f $BINDINGS ]]; then
      cat -- "$BINDINGS" > "$TMP_FILE"
      chmod --reference="$BINDINGS" "$TMP_FILE"
    else
      chmod 600 "$TMP_FILE"
    fi
    {
      echo ""
      echo "-- Added by omarchy-plugin-switcher on first load. Change the key or"
      echo "-- remove this block any time; it won't be re-added."
      echo "$LINE"
    } >> "$TMP_FILE"
    mv -f -- "$TMP_FILE" "$BINDINGS"
    TMP_FILE=""
    write_marker "$ACCEPTED_FILE"
    timeout 10 hyprctl reload > /dev/null 2>&1 || true
    ;;
  decline)
    ensure_state_dir
    take_lock
    write_marker "$DECLINED_FILE"
    ;;
  *)
    echo "Usage: omarchy-plugin-switcher-keybind <status|accept|decline>" >&2
    exit 1
    ;;
esac
