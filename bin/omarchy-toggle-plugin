#!/bin/bash
# Fuzzy-pick a plugin panel by name from the native Omarchy menu picker
# (the same list widget "Enable/Disable Plugin" uses) and toggle it open or
# closed via shell.toggle -- the same call the bar icon's onClicked makes.
# Lets one keybinding or bar icon reach any plugin panel without that
# plugin having to register any custom IPC of its own.

set -euo pipefail

FALLBACK_ICON=$'\U000f0431'
FIRST_PARTY_ROOT=/usr/share/omarchy/shell/plugins
THIRD_PARTY_ROOT="$HOME/.config/omarchy/plugins"

# Maps a first-party plugin id to its manifest dir, since those don't live
# under one id-named directory the way third-party plugins do.
declare -A first_party_dir
while IFS=$'\t' read -r manifest_id manifest_dir; do
  [[ -n $manifest_id ]] && first_party_dir[$manifest_id]=$manifest_dir
done < <(find "$FIRST_PARTY_ROOT" -mindepth 1 -maxdepth 4 -iname manifest.json -print0 2>/dev/null \
  | while IFS= read -r -d '' m; do
      jq -r --arg dir "$(dirname "$m")" '(.id // "") + "\t" + $dir' "$m" 2>/dev/null
    done)

# A plugin's bar icon glyph is only a QML literal for some plugins (e.g.
# `text: "..."`); others compute it at runtime from state (battery level,
# connection status, ...), e.g. `text: root.batteryIcon()`. Only the
# literal case can be read without running the plugin's own QML, so this
# is a best-effort lookup: static icons show correctly, dynamic ones fall
# back to the generic glyph.
plugin_icon() {
  local id=$1 dir="" entry="" file="" icon=""

  if [[ -f $THIRD_PARTY_ROOT/$id/manifest.json ]]; then
    dir="$THIRD_PARTY_ROOT/$id"
  elif [[ -n ${first_party_dir[$id]:-} ]]; then
    dir="${first_party_dir[$id]}"
  else
    echo "$FALLBACK_ICON"; return
  fi

  entry=$(jq -r '.entryPoints.barWidget // .entryPoints.panel // .entryPoints.overlay // .entryPoints.menu // empty' "$dir/manifest.json" 2>/dev/null)
  [[ -n $entry ]] || { echo "$FALLBACK_ICON"; return; }
  file="$dir/$entry"
  [[ -f $file ]] || { echo "$FALLBACK_ICON"; return; }

  icon=$(grep -A 10 "BarIconButton {" "$file" 2>/dev/null \
    | grep -m1 'text:' \
    | sed -nE 's/.*text:.*"([^"]*)".*/\1/p')

  [[ -n $icon ]] && echo "$icon" || echo "$FALLBACK_ICON"
}

if ! plugins=$(omarchy-plugin-list --json); then
  omarchy-notification-send "Plugin Switcher: failed to list plugins"
  exit 1
fi

ids=$(jq -r \
  '.[] | select(.enabled and .id != "houz42.plugin-switcher"
                and (.kinds | any(. == "bar-widget" or . == "panel" or . == "overlay" or . == "menu")))
   | .id' <<<"$plugins")

[[ -n $ids ]] || { omarchy-notification-send "No plugin panels available"; exit 0; }

rows=""
while IFS= read -r id; do
  name=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .name' <<<"$plugins")
  icon=$(plugin_icon "$id")
  rows+="$icon"$'\t'"$name"$'\t'"$id"$'\n'
done <<<"$ids"
rows=$(sort -t $'\t' -k2 <<<"$rows")

selection=$(omarchy-menu-select "Toggle plugin" <<<"$rows") || exit 0
[[ -n $selection ]] || exit 0

id=$(cut -f2 <<<"$selection")
[[ -n $id ]] || exit 1

omarchy-shell shell toggle "$id" "{}"
